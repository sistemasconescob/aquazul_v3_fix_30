# ═══════════════════════════════════════════════
# AQUAZUL — Configuración de producción
# Copia como .env y completa los valores
# ═══════════════════════════════════════════════

# Seguridad — cambia esto por algo aleatorio largo
JWT_SECRET=aquazul-super-secreto-cambia-esto-2024

# Admin inicial (se crea al primer inicio)
ADMIN_EMAIL=admin@aquazul.co
ADMIN_PASSWORD=Admin2024*

# URL pública del servidor (sin barra final)
APP_URL=https://tudominio.com

# Puerto
PORT=8000

# WhatsApp Business API (Meta)
# Guía: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WA_TOKEN=EAAxxxxxxxxxxxxxxx
WA_PHONE_ID=123456789012345
WA_API_VERSION=v19.0
